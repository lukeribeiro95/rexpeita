{
  "name": "tela",
  "version": "1.0.13",
  "description": "Compartilhamento de tela entre amigos via LiveKit",
  "author": "lukeribeiro95",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:native": "native\\build.cmd",
    "dist": "npm run build:native && electron-builder"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@sapphi-red/web-noise-suppressor": "^0.4.1",
    "livekit-client": "^2.5.0"
  },
  "build": {
    "appId": "com.lukeribeiro.tela",
    "productName": "Tela",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!native/**"
    ],
    "extraResources": [
      {
        "from": "native/bin/tela-loopback.exe",
        "to": "tela-loopback.exe"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "Tela-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Tela-Portable-${version}.exe"
    }
  }
}
